---
import Logo from './Logo.astro';
interface Props { current?: 'pro' | 'support' | 'none'; minimal?: boolean }
const { current = 'none', minimal = false } = Astro.props;
---
<header class="site-header" class:list={{ minimal }}>
  <div class="inner wrap">
    <a class="brand" href="/" aria-label="kwatch home"><Logo />kwatch</a>
    {!minimal && (
      <>
        <nav aria-label="Main">
          <a href="https://docs.kwatch.dev">Docs</a>
          <a href="https://blog.kwatch.dev">Blog</a>
          <a href="/pro" aria-current={current === 'pro' ? 'page' : undefined}>Pro</a>
          <a href="/support" aria-current={current === 'support' ? 'page' : undefined}>Get help</a>
          <a class="signin" href="https://app.kwatch.dev">Sign in</a>
        </nav>
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="Theme: System. Change theme" title="Theme: System">
          <svg class="i-system" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
          <svg class="i-light" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="i-dark" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 13.5A8.5 8.5 0 1 1 10.5 3a7 7 0 0 0 10.5 10.5z"/></svg>
        </button>
      </>
    )}
  </div>
</header>

<style>
  .site-header.minimal { border-bottom: 1px solid var(--line); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding-block: 22px; }
  .brand {
    display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text);
    font-family: var(--font-display); font-weight: 800; font-size: 26px; letter-spacing: -0.05em;
  }
  nav { display: flex; flex-wrap: wrap; gap: 8px 26px; font-size: 15px; flex: 1 1 auto; }
  nav a { color: var(--text-muted); text-decoration: none; }
  nav a:hover { color: var(--text); text-decoration: underline; }
  nav a[aria-current='page'] { color: var(--text); font-weight: 600; }
  nav a.signin { color: var(--text); font-weight: 700; }
  .theme-toggle {
    display: none; align-items: center; justify-content: center;
    width: var(--hit); height: var(--hit); padding: 0; cursor: pointer;
    background: transparent; color: var(--text);
    border: var(--btn-border) solid var(--control-border); border-radius: var(--radius-pill);
  }
  :global(html[data-theme-mode]) .theme-toggle { display: inline-flex; }
  .theme-toggle:hover { background: var(--text); color: var(--bg); border-color: var(--text); }
  .theme-toggle svg { display: none; }
  :global(html[data-theme-mode='system']) .i-system,
  :global(html[data-theme-mode='light']) .i-light,
  :global(html[data-theme-mode='dark']) .i-dark { display: block; }
  @media (max-width: 640px) {
    .theme-toggle { margin-left: auto; }
    .inner { gap: 12px 16px; }
    nav { order: 3; flex-basis: 100%; }
  }
</style>
