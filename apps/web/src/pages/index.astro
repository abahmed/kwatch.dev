---
import Base from '../layouts/Base.astro';
import BenefitIcon from '../components/BenefitIcon.astro';
import Panel from '../components/Panel.astro';
import InstallField from '../components/InstallField.astro';

const chart = 'https://github.com/abahmed/kwatch/blob/main/deploy/chart/README.md';
const failures = ['CrashLoopBackOff', 'OOMKilled', 'ImagePullBackOff', 'NodeNotReady', 'FailedScheduling', 'CertificateExpiring', 'PVC Pending', 'WebhookTimeout', 'RolloutStuck', 'CronJob missed'];

const alerts = [
  'FIRING KubePodCrashLooping checkout-api-7f9c-2xk',
  'FIRING KubePodCrashLooping checkout-api-7f9c-q8d',
  'FIRING TargetDown payments/checkout',
  'FIRING HighErrorRate cart-svc 5xx 38%',
  'FIRING KubeDeploymentReplicasMismatch checkout',
  'FIRING KubePodNotReady checkout-api-7f9c-mm1',
  '+ 41 more',
];

const catches = [
  ['Apps that keep crashing', 'Crash loops, out-of-memory kills, image pull failures and pods stuck waiting to start', 'CrashLoopBackOff, OOMKilled, Pending'],
  ['Servers that go down', 'A machine in your cluster stops responding, runs low on resources or is being drained', 'Node NotReady, pressure, draining'],
  ['Deploys that never finish', 'A new version that does not roll out, jobs that fail and scheduled jobs that never ran', 'Stuck rollouts, failed Jobs, missed CronJobs'],
  ['Disks that fill up or will not attach', 'Storage requests that stay pending or cannot attach, and volumes that are almost full', 'PVC Pending, attach failures'],
  ['Services nobody can reach', 'A service with nothing behind it, or traffic rules that block it', 'No endpoints, Ingress, NetworkPolicy'],
  ['Certificates about to expire', 'Security certificates that are close to expiring or already invalid', 'TLS certificates'],
  ['The cluster itself', 'The parts that run Kubernetes, DNS, and the checks that approve or reject changes', 'API server, etcd, DNS, admission webhooks'],
  ['Custom add-ons', 'Failing conditions on resources that other tools add to your cluster', 'Custom resources (CRDs)'],
];

const glossary = [
  ['Cluster', 'The group of machines that runs your apps.'],
  ['Node', 'One machine in the cluster.'],
  ['Pod', 'A running copy of an app.'],
  ['Namespace', 'A named area of the cluster, often one per team or app.'],
  ['CrashLoopBackOff', 'A pod keeps starting, failing and restarting.'],
  ['OOMKilled', 'A pod used more memory than allowed and was stopped.'],
  ['RBAC', 'Kubernetes permissions. It decides what kwatch may read.'],
  ['Helm', 'A package manager for Kubernetes, an alternative way to install.'],
  ['CRD', 'A custom resource definition, an extra kind of object that a tool adds to the cluster.'],
  ['Rollout', 'Replacing the running version of an app with a new one.'],
  ['ConfigMap', 'A settings object an app reads, such as a database address.'],
  ['PDB and HPA', 'A PodDisruptionBudget limits how many copies of an app may be down at once. A HorizontalPodAutoscaler adds or removes copies as load changes.'],
];

const benefits = [
  ['root', 'Root cause first', 'kwatch follows a failure upstream and names the one cause.'],
  ['data', 'Your data stays in your cluster', 'kwatch analyzes events and logs where they live.'],
  ['quiet', 'Quiet by default', 'One message, then silence until something new is true.'],
  ['who', 'Who changed what', 'See who changed what, and when.'],
  ['next', 'The next step', 'Every message ends with the command to run.'],
  ['channels', '50+ channels', 'Slack, Teams, PagerDuty, email, webhooks and more.'],
];

const timeline = [
  ['03:07', 'Opened: checkout-api crash-looping, cause found'],
  ['03:11', 'Update: cart-svc now affected too'],
  ['03:16', 'Fix detected: checkout-config rolled back'],
  ['03:21', 'Resolved after 14 minutes'],
];

const faq = [
  ['Do I need to be a Kubernetes expert?', 'No. One command, and it walks you through it with plain questions. It checks your cluster before it changes anything. Alerts say what broke, why and what to do next in plain words, with the technical names alongside for people who want them.'],
  ['Will it work on my cluster?', 'kwatch runs on any conformant Kubernetes cluster. The installer checks your cluster before it changes anything.'],
  ['Where do alerts go?', 'Slack, Teams, Discord, PagerDuty, email, webhooks and 50+ other channels.'],
  ['How do I get Pro?', 'Pro is free during early access. Get a key at app.kwatch.dev, then open the installer and choose License / Pro > Add or replace key.'],
  ['Can I install with Helm?', 'Yes. The chart guide walks you through it; the installer is the quickest way.'],
];

const site = 'https://kwatch.dev';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'kwatch',
    url: site,
    description: 'Runs inside your Kubernetes cluster, traces every failure back to what started it, and sends one message: what broke, why, who changed it, and what to do next.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Kubernetes',
    license: 'https://github.com/abahmed/kwatch/blob/main/LICENSE',
    codeRepository: 'https://github.com/abahmed/kwatch',
    image: `${site}/og.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'kwatch',
    url: site,
    logo: `${site}/apple-touch-icon.png`,
    sameAs: ['https://github.com/abahmed/kwatch', 'https://docs.kwatch.dev'],
    email: 'hello@kwatch.dev',
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'kwatch', url: site },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base
  title="kwatch: Kubernetes monitoring and alerts with the root cause"
  description="kwatch is Kubernetes monitoring and alerting that runs in your cluster and turns CrashLoopBackOff, OOMKilled and more into one incident with the root cause and fix, sent to Slack or 50+ channels."
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="mono-line">03:07 · #prod-alerts · 47 new messages</p>
      <h1><span class="sr-only">kwatch: </span>Fifty alerts.<br /><span class="mark">One cause.</span></h1>
      <p class="lede">kwatch runs inside your Kubernetes cluster, traces every failure back to what started it, and sends one message: what broke, why, who changed it, and what to do next.</p>
      <div class="install-block">
        <InstallField id="install" label="Install in one command" />
        <p class="install-sub">It walks you through it and checks your cluster before it changes anything.</p>
      </div>
      <p class="hero-links">
        <a class="link-strong" href={chart}>Already use Helm? See the chart guide →</a>
        <a class="link-strong" href="#editions">Pro is free during early access →</a>
      </p>
      <p class="watches">Watches crash loops, out-of-memory kills, failed rollouts, image pull errors, node pressure and more.</p>
    </div>

    <div class="hero-visual">
      <figure class="proof">
        <ul class="noise" aria-hidden="true">
          {[...alerts.slice(0, 4), alerts[6]].map((a, i) => <li class:list={{ dim1: i === 3, dim2: i === 4 }}>{a}</li>)}
        </ul>
        <figcaption>Without kwatch</figcaption>
      </figure>
      <figure class="proof" id="example">
        <div class="card on-ink" role="group" aria-label="Example kwatch alert">
          <div class="card-top"><span>kwatch · 1 incident</span><span class="accent">ROOT CAUSE FOUND</span></div>
          <p class="card-title">checkout-api is crash-looping because a ConfigMap changed 4 minutes ago.</p>
          <dl>
            <dt>Why</dt><dd><code>DB_HOST</code> points to a host that doesn't resolve</dd>
            <dt>Who</dt><dd>deploy-bot, via Argo CD</dd>
            <dt>Impact</dt><dd>payments, cart</dd>
            <dt>Next</dt><dd>Roll back <code>checkout-config</code></dd>
          </dl>
        </div>
        <figcaption>With kwatch. Example alert.</figcaption>
      </figure>
    </div>
  </section>

  <div class="strip on-ink">
    <div class="wrap strip-inner">
      <span class="strip-label">Catches</span>
      <ul class="strip-list">
        {failures.map((f) => <li>{f}</li>)}
      </ul>
      <a class="strip-link" href="#catches">See everything it catches →</a>
    </div>
  </div>

  <section id="catches" class="band">
    <div class="wrap section">
      <div class="catches-head">
        <div>
          <p class="eyebrow">What kwatch watches</p>
          <h2 class="display h2-md">The failures that wake people up.</h2>
        </div>
        <p class="catches-sub">Crash loops, out-of-memory kills, failed rollouts, image pull errors, node pressure and more. Built in, no rules to write.</p>
      </div>
      <ul class="grid">
        {catches.map(([name, text, term]) => (
          <li><p class="cell-name">{name}</p><p class="cell-text">{text}</p><p class="cell-term">{term}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section id="how" class="wrap section">
    <p class="eyebrow">How it works in 30 seconds</p>
    <h2 class="display h2-lg">It follows the trail, the way you would.</h2>
    <p class="lede-lg">When something breaks in your Kubernetes cluster, kwatch tells you what broke, why, and what to do, in Slack, Discord, email and 50+ other channels.</p>
    <ol class="steps">
      <li>
        <p class="eyebrow">Step 1</p>
        <h3>Install</h3>
        <p>Run one command. It asks a few questions.</p>
        <div class="terminal on-ink" role="group" aria-label="Example installer session">
          <div class="dim">? Where should alerts go? <span class="accent">› Slack</span></div>
          <div class="dim">? Add a Pro license key? <span class="bright">(Enter to skip)</span></div>
          <div class="dim">✓ kwatch is running</div>
        </div>
      </li>
      <li>
        <p class="eyebrow">Step 2</p>
        <h3>It watches</h3>
        <p>kwatch runs as one small pod in your cluster and keeps a live map of what depends on what.</p>
        <ol class="trace" aria-label="Example trace, from symptom to cause">
          <li>Pod checkout-api-7f9c · <span class="failing">CrashLoopBackOff</span></li>
          <li>Deployment checkout-api · healthy before 03:03</li>
          <li>Node worker-3 · <span class="resolved">healthy</span></li>
          <li class="cause">ConfigMap checkout-config · changed 03:03 ← cause</li>
        </ol>
      </li>
      <li>
        <p class="eyebrow">Step 3</p>
        <h3>You hear</h3>
        <p>When something breaks you get one clear message: what broke, why, and what to do.</p>
        <p class="step-link"><a class="link-strong" href="#example">See the example alert →</a></p>
      </li>
    </ol>
    <details class="glossary">
      <summary>New to Kubernetes? Plain-English glossary</summary>
      <dl>
        {glossary.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
    </details>
  </section>

  <section id="benefits" class="band">
    <div class="wrap section">
      <p class="eyebrow">Why teams keep it</p>
      <h2 class="display h2-md">One message, with the cause.</h2>
      <ul class="benefits">
        {benefits.map(([i, n, t]) => (
          <li id={i === 'data' ? 'data' : undefined}>
            {i === 'quiet' ? (
              <details class="b-details">
                <summary><BenefitIcon name="quiet" /><span class="b-name">{n}</span><span class="b-text">{t}</span></summary>
                <p class="b-more">kwatch waits for failures to settle, merges what belongs together and speaks when there is news.</p>
                <ol class="timeline">
                  {timeline.map(([tm, text], k) => (
                    <li><p class="time">{tm}</p><p class="event">{k === 3 ? <><span class="resolved">Resolved</span> after 14 minutes</> : text}</p></li>
                  ))}
                </ol>
              </details>
            ) : (
              <div class="b-body"><BenefitIcon name={i as 'root'} /><p class="b-name">{n}</p><p class="b-text">{t}</p></div>
            )}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section id="editions" class="wrap section">
    <div class="pro-head">
      <h2 class="display h2-lg">Free. And Pro is free too.</h2>
      <p>Pro is free during early access. No payment details.</p>
    </div>
    <div class="panels editions">
      <Panel title="Community" sub="Free forever. No account, no key.">
        <p class="body">Apps that keep crashing (crash loops, out-of-memory kills), pods stuck waiting and servers that go down (NotReady nodes), explained in one line and sent to your channel.</p>
        <a slot="footer" class="btn btn-line" href="#install">Install kwatch</a>
      </Panel>
      <Panel title="Pro" sub="Free during early access." tone="soft">
        <p class="body">Every detector. The full proof and who made the change. Unlimited channels with routing and threads. History, audit log, maintenance windows and runbooks.</p>
        <Fragment slot="footer">
          <a class="btn btn-solid" href="https://app.kwatch.dev">Get a free Pro license</a>
          <a class="link-strong compare" href="/pro">Compare editions →</a>
        </Fragment>
      </Panel>
    </div>
    <p class="editions-note">Licenses are managed in the installer: License / Pro > Add or replace key.</p>
  </section>

  <section class="band" aria-labelledby="trust-title">
    <div class="wrap section">
      <p class="eyebrow">Read it before you run it</p>
      <h2 id="trust-title" class="display h2-md">Nothing hidden.</h2>
      <ul class="trust">
        <li><p class="b-name">Source available.</p><p class="b-text">Read every line on GitHub, under ELv2. <a class="link-strong" href="https://github.com/abahmed/kwatch">View the repository →</a></p></li>
        <li><p class="b-name">One small pod.</p><p class="b-text">A small volume for state, nothing else to run.</p></li>
        <li><p class="b-name">Your data stays in your cluster.</p><p class="b-text">kwatch analyzes events and logs where they live.</p></li>
      </ul>
    </div>
  </section>

  <section class="faq">
    <div class="faq-inner">
      <p class="eyebrow">Questions</p>
      <h2 class="display h2-md">Fair questions</h2>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta on-signal">
    <div class="wrap cta-inner">
      <h2 class="display">Sleep through<br />the noise.</h2>
      <div class="cta-install">
        <InstallField onSignal label="Install kwatch" />
        <p class="cta-sub">Prefer Helm? <a href={chart}>See the chart guide.</a></p>
      </div>
    </div>
  </section>
  <script src="../scripts/copy.js"></script>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gutter); column-gap: var(--space-8); align-items: start; padding-block: var(--space-7) var(--space-9); }
  .mono-line { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); }
  h1 {
    margin-top: var(--space-4); font-family: var(--font-display); font-weight: 800;
    font-size: var(--h1-marketing); line-height: 0.95; letter-spacing: -0.045em;
  }
  .mark { background: var(--text); color: var(--bg); padding: 0 var(--space-3); border-radius: var(--radius-input); box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .lede { margin-top: var(--space-5); font-size: clamp(18px, 1vw + 14px, 21px); color: var(--text-soft); max-width: var(--measure); }
  .install-block { margin-top: var(--space-6); max-width: 680px; }
  .install-sub { margin-top: var(--space-3); font-size: var(--text-small); color: var(--text-muted); }
  .hero-links { margin-top: var(--space-4); display: flex; flex-wrap: wrap; gap: var(--space-2) var(--space-5); font-size: var(--text-small); }
  .hero-links a { display: inline-flex; align-items: center; min-height: var(--hit); }
  .lede-lg { margin-top: var(--space-4); font-size: 18px; color: var(--text-soft); max-width: var(--measure); }
  .hero-visual { display: flex; flex-direction: column; gap: var(--space-4); min-width: 0; }
  .proof { margin: 0; min-width: 0; }
  .proof + .proof { border-top: 1px solid var(--line); padding-top: var(--space-4); }
  figcaption { margin-top: var(--space-2); font-family: var(--font-mono); font-size: var(--text-micro); color: var(--text-muted); }
  .noise { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 6px; font-family: var(--font-mono); font-size: var(--text-micro); color: var(--text-muted); }
  .noise li { padding: var(--space-2) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-chip); overflow-wrap: anywhere; }
  .noise .dim1 { opacity: .6; }
  .noise .dim2 { opacity: .4; }
  .card {
    position: relative; background: var(--ink); color: var(--ink-text); border: 1px solid var(--ink-line);
    border-radius: var(--radius-output); padding: var(--space-5) var(--space-5) 22px; box-shadow: var(--shadow-output);
  }
  .card-top { display: flex; justify-content: space-between; gap: var(--space-3); font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .accent { color: var(--ink-text); font-weight: 600; }
  .card-title { margin-top: 14px; font-family: var(--font-display); font-weight: 700; font-size: var(--h3-card); line-height: 1.2; }
  .card dl { margin-top: var(--space-4); display: grid; grid-template-columns: 80px 1fr; gap: 6px var(--space-3); font-size: var(--text-small); }
  .card dt { color: var(--ink-muted); }
  .card dd { margin: 0; }
  .card code { font-size: var(--text-micro); }

  /* Keyword strip (static) */
  .strip { background: var(--ink); color: var(--ink-text); border-block: 1px solid var(--ink-line); font-family: var(--font-mono); font-size: var(--text-small); padding: var(--space-4) 0; }
  .strip-inner { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-2) var(--space-5); }
  .strip-label { color: var(--ink-muted); }
  .strip-list { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-4); flex: 1 1 400px; }
  .strip-link { color: var(--ink-text); text-decoration: underline; }

  .watches { font-size: var(--text-small); color: var(--text-muted); max-width: var(--measure); }
  .catches-head { display: grid; grid-template-columns: 5fr 7fr; gap: var(--space-7); align-items: end; }
  .catches-sub { color: var(--text-soft); font-size: 18px; max-width: var(--measure); }
  .grid { list-style: none; padding: 0; margin-top: var(--space-7); display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; }
  .grid li { background: var(--bg); padding: 22px; min-width: 0; }
  .cell-name { font-weight: 600; }
  .cell-text { margin-top: 6px; font-size: 14px; color: var(--text-muted); }
  .cell-term { margin-top: var(--space-2); font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .resolved { color: var(--resolved); }
  .failing { color: var(--failing); }

  /* How */
  .steps { list-style: none; padding: 0; margin-top: var(--space-8); display: grid; grid-template-columns: 4fr 5fr 3fr; border-top: 2px solid var(--text); }
  .steps > li { padding: var(--space-6); border-right: 1px solid var(--line); min-width: 0; }
  .steps > li:first-child { padding-left: 0; }
  .steps > li:last-child { padding-right: 0; border-right: 0; }
  .steps h3 { margin: var(--space-3) 0 var(--space-2); font-family: var(--font-display); font-weight: 700; font-size: var(--h3-card); letter-spacing: -0.02em; line-height: 1.15; }
  .steps p:not(.eyebrow) { color: var(--text-soft); }
  .step-link { margin-top: var(--space-3); }
  .terminal { margin-top: 18px; background: var(--ink); color: var(--ink-text); border: 1px solid var(--ink-line); border-radius: var(--radius-card); padding: var(--space-4) 18px; font-family: var(--font-mono); font-size: 14px; display: grid; gap: 6px; overflow-wrap: anywhere; }
  .dim { color: var(--ink-muted); }
  .bright { color: var(--ink-text); }
  .trace { list-style: none; padding: 0; margin-top: 18px; font-family: var(--font-mono); font-size: var(--text-micro); display: flex; flex-direction: column; gap: 6px; }
  .trace li { padding: var(--space-2) var(--space-3); border: 1px solid var(--line); border-radius: var(--radius-chip); color: var(--text-muted); }
  .trace li:nth-child(2) { margin-left: 18px; }
  .trace li:nth-child(3) { margin-left: 36px; }
  .trace li.cause { margin-left: 54px; background: var(--text); color: var(--bg); font-weight: 500; border-color: var(--text); }
  .glossary { margin-top: var(--space-6); border: 1px solid var(--line); border-radius: var(--radius-card); padding: var(--space-1) var(--space-5); background: var(--bg); }
  .glossary summary { cursor: pointer; font-weight: 600; font-size: 17px; min-height: var(--hit); display: flex; align-items: center; }
  .glossary dl { display: grid; grid-template-columns: 180px 1fr; gap: var(--space-3) var(--space-5); padding: var(--space-1) 0 18px; }
  .glossary dt { font-family: var(--font-mono); font-size: 14px; }
  .glossary dd { margin: 0; color: var(--text-soft); }

  /* Benefits */
  .benefits, .trust { list-style: none; padding: 0; margin-top: var(--space-7); display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: var(--radius-card); overflow: hidden; }
  .benefits > li, .trust > li { background: var(--bg); padding: 22px; min-width: 0; }
  .band .trust > li { background: var(--surface); }
  .benefits svg { color: var(--text); }
  .b-name { margin-top: var(--space-3); font-weight: 600; display: block; }
  .b-text { margin-top: var(--space-1); font-size: 14px; color: var(--text-muted); display: block; }
  .trust .b-name { margin-top: 0; }
  .trust a { text-decoration: underline; }
  .b-details summary { cursor: pointer; list-style: none; min-height: var(--hit); position: relative; padding-right: var(--space-6); }
  .b-details summary::-webkit-details-marker { display: none; }
  .b-details summary::after { content: ''; position: absolute; right: 0; top: 4px; width: 14px; height: 14px; background: linear-gradient(currentColor, currentColor) center / 100% 2px no-repeat, linear-gradient(currentColor, currentColor) center / 2px 100% no-repeat; }
  .b-details[open] summary::after { background: linear-gradient(currentColor, currentColor) center / 100% 2px no-repeat; }
  .b-more { margin-top: var(--space-3); font-size: 14px; color: var(--text-soft); }
  .timeline { list-style: none; margin: var(--space-4) 0 0; padding: 0 0 0 var(--space-4); border-left: 2px solid var(--text); display: flex; flex-direction: column; gap: var(--space-3); }
  .time { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--text-muted); }
  .event { margin-top: 2px; font-weight: 600; font-size: 14px; }

  /* Editions */
  .pro-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-5); align-items: end; }
  .pro-head p { max-width: 400px; color: var(--text-soft); }
  .pro-head .h2-lg { margin-top: 0; }
  .editions { margin-top: var(--space-7); }
  .compare { padding: 13px var(--space-2); }
