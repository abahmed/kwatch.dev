{
  "name": "kwatch-dev",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start:docs": "yarn workspace @kwatch/docs start",
    "build:docs": "yarn workspace @kwatch/docs build",
    "typecheck": "yarn workspace @kwatch/docs typecheck",
    "docs:generate": "yarn workspace @kwatch/docs docs:generate",
    "docs:verify": "yarn workspace @kwatch/docs docs:verify",
    "seo:verify": "yarn workspace @kwatch/docs seo:verify",
    "test:manager": "yarn workspace @kwatch/docs test:manager",
    "check": "yarn typecheck && yarn docs:verify && yarn test:manager && yarn build:docs && yarn seo:verify"
  },
  "engines": {
    "node": ">=18.0"
  }
}
