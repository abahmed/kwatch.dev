---
import Logo from './Logo.astro';
interface Props { current?: 'pro' | 'support' | 'none'; minimal?: boolean }
const { current = 'none', minimal = false } = Astro.props;
---
<header class="site-header" class:list={{ minimal }}>
  <div class="inner wrap">
    <a class="brand" href="/" aria-label="kwatch home"><Logo />kwatch</a>
    {!minimal && (
      <>
        <nav aria-label="Main">
          <a href="https://docs.kwatch.dev">Docs</a>
          <a href="/pro" aria-current={current === 'pro' ? 'page' : undefined}>Pro</a>
          <a href="/support" aria-current={current === 'support' ? 'page' : undefined}>Get help</a>
          <a href="https://app.kwatch.dev">Sign in</a>
        </nav>
        <a class="btn btn-line install-pill" href="/#install">Install</a>
      </>
    )}
  </div>
</header>

<style>
  .site-header.minimal { border-bottom: 1px solid var(--line); }
  .inner { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 32px; padding-block: 22px; }
  .brand {
    display: flex; align-items: center; gap: 8px; text-decoration: none; color: var(--text);
    font-family: var(--font-display); font-weight: 800; font-size: 26px; letter-spacing: -0.05em;
  }
  nav { display: flex; flex-wrap: wrap; gap: 8px 26px; font-size: 15px; flex: 1 1 auto; }
  nav a { color: var(--text-muted); text-decoration: none; }
  nav a:hover { color: var(--text); text-decoration: underline; }
  nav a[aria-current='page'] { color: var(--text); font-weight: 600; }
  .install-pill { padding-block: 8px; }
  @media (max-width: 700px) {
    .inner { gap: 8px 16px; padding-block: 14px; }
    nav { order: 3; flex-basis: 100%; }
    .install-pill { margin-left: auto; }
  }
</style>
