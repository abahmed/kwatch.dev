---
import { formatDate, getPosts, tagCounts } from '../lib/posts';
const all = await getPosts();
const posts = all.slice(0, 4);
const tags = tagCounts(all);
---
<dialog class="search" id="search" aria-label="Search the blog">
  <form method="dialog" role="search" data-search-form>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /></svg>
    <input type="search" id="search-input" placeholder="Search the blog" aria-label="Search the blog" autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="search-results" aria-autocomplete="list" />
    <button type="button" class="close" data-search-close aria-label="Close search">Esc</button>
  </form>
  <div class="body">
    <div id="search-idle">
      <p class="group">LATEST POSTS</p>
      <div role="listbox" aria-label="Latest posts">
        {posts.map((p) => (
          <a role="option" aria-selected="false" href={`/${p.id}`}><strong>{p.data.title}</strong><span>{formatDate(p.data.date)}</span></a>
        ))}
      </div>
      <p class="group">TAGS</p>
      <div class="chips" role="group" aria-label="Tags">
        {tags.map((t) => <a class="chip" href={`/tags/${t.slug}`}>{t.tag}<i>{t.count}</i></a>)}
      </div>
    </div>
    <div id="search-results" role="listbox" aria-label="Results" hidden></div>
    <div id="search-none" class="none" hidden>
      <h2 id="search-none-title">No posts match.</h2>
      <p>Try a symptom, such as <a href="/tags/crashloopbackoff">CrashLoopBackOff</a> or <a href="/tags/oomkilled">OOMKilled</a>.</p>
    </div>
  </div>
  <p class="hints" aria-hidden="true"><span>Up Down to move</span><span>Enter to open</span><span>Esc to close</span></p>
  <p class="sr-only" id="search-status" role="status" aria-live="polite"></p>
</dialog>
