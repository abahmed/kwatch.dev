---
import Base from '../layouts/Base.astro';
import BenefitIcon from '../components/BenefitIcon.astro';
import Panel from '../components/Panel.astro';
import DataFlows from '../components/DataFlows.astro';

const failures = ['CrashLoopBackOff', 'OOMKilled', 'ImagePullBackOff', 'NodeNotReady', 'FailedScheduling', 'CertificateExpiring', 'PVC Pending', 'WebhookTimeout', 'RolloutStuck', 'CronJob missed'];

const alerts = [
  'FIRING KubePodCrashLooping checkout-api-7f9c-2xk',
  'FIRING KubePodCrashLooping checkout-api-7f9c-q8d',
  'FIRING TargetDown payments/checkout',
  'FIRING HighErrorRate cart-svc 5xx 38%',
  'FIRING KubeDeploymentReplicasMismatch checkout',
  'FIRING KubePodNotReady checkout-api-7f9c-mm1',
  '+ 41 more',
];

const catches = [
  ['Apps that keep crashing', 'Crash loops, out-of-memory kills, image pull failures and pods stuck waiting to start', 'CrashLoopBackOff, OOMKilled, Pending'],
  ['Servers that go down', 'A machine in your cluster stops responding, runs low on resources or is being drained', 'Node NotReady, pressure, draining'],
  ['Deploys that never finish', 'A new version that does not roll out, jobs that fail and scheduled jobs that never ran', 'Stuck rollouts, failed Jobs, missed CronJobs'],
  ['Disks that fill up or will not attach', 'Storage requests that stay pending or cannot attach, and volumes that are almost full', 'PVC Pending, attach failures'],
  ['Services nobody can reach', 'A service with nothing behind it, or traffic rules that block it', 'No endpoints, Ingress, NetworkPolicy'],
  ['Certificates about to expire', 'Security certificates that are close to expiring or already invalid', 'TLS certificates'],
  ['The cluster itself', 'The parts that run Kubernetes, DNS, and the checks that approve or reject changes', 'API server, etcd, DNS, admission webhooks'],
  ['Custom add-ons', 'Failing conditions on resources that other tools add to your cluster', 'Custom resources (CRDs)'],
];

const glossary = [
  ['Cluster', 'The group of machines that runs your apps.'],
  ['Node', 'One machine in the cluster.'],
  ['Pod', 'A running copy of an app.'],
  ['Namespace', 'A named area of the cluster, often one per team or app.'],
  ['CrashLoopBackOff', 'A pod keeps starting, failing and restarting.'],
  ['OOMKilled', 'A pod used more memory than allowed and was stopped.'],
  ['RBAC', 'Kubernetes permissions. It decides what kwatch may read.'],
  ['Helm', 'A package manager for Kubernetes, an alternative way to install.'],
  ['CRD', 'A custom resource definition, an extra kind of object that a tool adds to the cluster.'],
  ['Rollout', 'Replacing the running version of an app with a new one.'],
  ['ConfigMap', 'A settings object an app reads, such as a database address.'],
  ['PDB and HPA', 'A PodDisruptionBudget limits how many copies of an app may be down at once. A HorizontalPodAutoscaler adds or removes copies as load changes.'],
];

const steps = [
  ['Step 1', 'Install', 'Run one command. It asks a few questions.'],
  ['Step 2', 'It watches', 'kwatch runs as one small pod in your cluster and keeps a live map of what depends on what.'],
  ['Step 3', 'You hear', 'When something breaks you get one clear message: what broke, why, and what to do.'],
];

const benefits = [
  ['root', 'Root cause first', 'kwatch follows a failure upstream and names the one cause.'],
  ['data', 'Your data stays in your cluster', 'kwatch analyzes events and logs where they live.'],
  ['quiet', 'Quiet by default', 'One message, then silence until something new is true.'],
  ['who', 'Who changed what', 'See who changed what, and when.'],
  ['next', 'The next step', 'Every message ends with the command to run.'],
  ['channels', '50+ channels', 'Slack, Teams, PagerDuty, email, webhooks and more.'],
];

const timeline = [
  ['03:07', 'Opened: checkout-api crash-looping, cause found'],
  ['03:11', 'Update: cart-svc now affected too'],
  ['03:16', 'Fix detected: checkout-config rolled back'],
  ['03:21', 'Resolved after 14 minutes'],
];

const faq = [
  ['Do I need to be a Kubernetes expert?', 'No. One command, and it walks you through it with plain questions. It checks your cluster before it changes anything. Alerts say what broke, why and what to do next in plain words, with the technical names alongside for people who want them.'],
  ['Will it work on my cluster?', 'kwatch runs on any conformant Kubernetes cluster. The installer checks your cluster before it changes anything.'],
  ['Does it replace Prometheus?', 'No. Keep your metrics. kwatch answers a different question: when something breaks, what caused it and what to do.'],
  ['What leaves my cluster?', 'Only optional anonymous usage stats and Pro license checks reach kwatch.dev. Usage stats go at most once a week and contain an anonymous ID derived from your cluster (a one-way hash that cannot be traced back to the cluster or linked to your license) and the kwatch version; turn them off with telemetry.enabled: false or KWATCH_TELEMETRY=false. A Pro license check goes once a day and contains the license ID, a hashed cluster ID, the kwatch version and the node count. Community sends none. Never cluster names, namespaces, pod names, logs or events. Alerts go only to the channels you set up.'],
  ['What permissions does it need?', 'Read access to the resources it watches, through Kubernetes permissions (RBAC) that decide what kwatch may read. It writes only its own lock and license record in its own namespace, and never changes your workloads.'],
  ['Why is Pro free?', "We want kwatch proven on real clusters first. If that ever changes, you will hear well in advance."],
];

const site = 'https://kwatch.dev';
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: 'kwatch',
    url: site,
    description: 'Runs inside your Kubernetes cluster, traces every failure back to what started it, and sends one message: what broke, why, who changed it, and what to do next.',
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Kubernetes',
    license: 'https://github.com/abahmed/kwatch/blob/main/LICENSE',
    codeRepository: 'https://github.com/abahmed/kwatch',
    image: `${site}/og.png`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: 'kwatch',
    url: site,
    logo: `${site}/apple-touch-icon.png`,
    sameAs: ['https://github.com/abahmed/kwatch', 'https://docs.kwatch.dev'],
    email: 'hello@kwatch.dev',
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'kwatch', url: site },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
---
<Base
  title="kwatch: Kubernetes monitoring and alerts with the root cause"
  description="kwatch is Kubernetes monitoring and alerting that runs in your cluster and turns CrashLoopBackOff, OOMKilled and more into one incident with the root cause and fix, sent to Slack or 50+ channels."
  jsonLd={jsonLd}
>
  <section class="hero wrap">
    <div class="hero-text">
      <p class="mono-line">03:07 · #prod-alerts · 47 new messages</p>
      <h1><span class="sr-only">kwatch: </span>Fifty alerts.<br /><span class="mark">One cause.</span></h1>
      <p class="lede">When something breaks in your Kubernetes cluster, kwatch tells you what broke, why, and what to do, in Slack, Discord, email and 50+ other channels.</p>
      <p class="lede-sub">kwatch runs inside your Kubernetes cluster, traces every failure back to what started it, and sends one message: what broke, why, who changed it, and what to do next.</p>
      <div class="actions">
        <a class="btn btn-solid big" href="#install">Install free</a>
        <a class="link-strong big-link" href="#pro">Pro is free during early access →</a>
      </div>
    </div>

    <div class="hero-visual">
      <ul class="noise" aria-hidden="true">
        {alerts.map((a, i) => <li class:list={{ dim1: i === 5, dim2: i === 6 }}>{a}</li>)}
      </ul>
      <div class="card on-ink" role="group" aria-label="Example kwatch alert">
        <div class="card-top"><span>kwatch · 1 incident</span><span class="signal">ROOT CAUSE FOUND</span></div>
        <p class="card-title">checkout-api is crash-looping because a ConfigMap changed 4 minutes ago.</p>
        <dl>
          <dt>Why</dt><dd><code>DB_HOST</code> points to a host that doesn't resolve</dd>
          <dt>Who</dt><dd>deploy-bot, via Argo CD</dd>
          <dt>Impact</dt><dd>payments, cart</dd>
          <dt>Next</dt><dd>Roll back <code>checkout-config</code></dd>
        </dl>
      </div>
      <p class="note">Illustrative example.</p>
    </div>
  </section>

  <div class="strip on-ink" aria-hidden="true">
    <div class="track">
      {[0, 1].map(() => (
        <span class="run">{failures.map((f) => <span class="item">{f}<i>/</i></span>)}</span>
      ))}
    </div>
  </div>

  <DataFlows facts />

  <section id="quick" class="wrap section quick">
    <p class="eyebrow">How it works in 30 seconds</p>
    <ol class="quick-steps">
      {steps.map(([k, h, t]) => (<li><p class="eyebrow">{k}</p><h3>{h}</h3><p>{t}</p></li>))}
    </ol>
    <p class="quick-note">The example alert above is what step 3 looks like.</p>
    <ul class="benefits">
      {benefits.map(([i, n, t]) => (<li><BenefitIcon name={i as 'root'} /><p class="b-name">{n}</p><p class="b-text">{t}</p></li>))}
    </ul>
  </section>

  <section id="how" class="wrap section">
    <p class="eyebrow">How it works</p>
    <h2 class="display h2-lg">It follows the trail, the way you would. <span class="underline">In seconds.</span></h2>
    <ol class="steps">
      <li>
        <p class="eyebrow">1 — watch</p>
        <h3>Keeps a live map of your cluster</h3>
        <p>Pods, workloads, nodes, volumes, configs, services and certificates, how they connect, and every change made to them, with who made it.</p>
      </li>
      <li>
        <p class="eyebrow">2 — trace</p>
        <h3>Walks back to the first domino</h3>
        <p>When something fails, it follows the links upstream and only blames what is actually broken or recently changed.</p>
        <ol class="trace" aria-label="Example trace, from symptom to cause">
          <li>Pod checkout-api-7f9c · <span class="failing">CrashLoopBackOff</span></li>
          <li>Deployment checkout-api · healthy before 03:03</li>
          <li>Node worker-3 · <span class="resolved">healthy</span></li>
          <li class="cause">ConfigMap checkout-config · changed 03:03 ← cause</li>
        </ol>
      </li>
      <li>
        <p class="eyebrow">3 — tell</p>
        <h3>Sends one message, then stays quiet</h3>
        <p>Symptoms join one incident. You hear again only when something material changes, and once more when it's resolved.</p>
      </li>
    </ol>
  </section>

  <section id="catches" class="band">
    <div class="wrap section">
      <div class="catches-head">
        <div>
          <p class="eyebrow">What it catches</p>
          <h2 class="display h2-md">The failures that wake people up.</h2>
        </div>
        <p class="catches-sub">Built in, no rules to write. Community covers apps that crash and servers that go down; Pro covers everything below.</p>
      </div>
      <ul class="grid">
        {catches.map(([name, text, term]) => (
          <li><p class="cell-name">{name}</p><p class="cell-text">{text}</p><p class="cell-term">{term}</p></li>
        ))}
      </ul>
      <details class="glossary">
        <summary>New to Kubernetes? Plain-English glossary</summary>
        <dl>
          {glossary.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
        </dl>
      </details>
    </div>
  </section>

  <section class="wrap section quiet">
    <div>
      <p class="eyebrow">One incident, one thread</p>
      <h2 class="display h2-md">Quiet by default.</h2>
      <p class="quiet-lede">No repeats every five minutes, no flapping storms. kwatch waits for failures to settle, merges what belongs together and speaks when there is news.</p>
      <p class="quiet-note">Updates arrive in one thread on Slack with Pro; in Community they arrive as short follow-up messages.</p>
    </div>
    <ol class="timeline">
      {timeline.map(([t, text], i) => (
        <li>
          <p class="time">{t}</p>
          <p class="event">{i === 3 ? <><span class="resolved">Resolved</span> after 14 minutes</> : text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="install" class="install on-ink">
    <div class="wrap section">
      <h2 class="display h2-lg">One command, and it<br /><span class="signal">walks you through it.</span></h2>
      <div class="terminal" role="group" aria-label="Example installer session">
        <div><span class="dim">$</span> /bin/bash -c "$(curl -fsSL https://kwatch.dev/kwatch.sh)"</div>
        <div class="gap dim">✓ Connected to <span class="bright">prod-eu-1</span></div>
        <div class="dim">? Where should alerts go? <span class="signal">› Slack</span></div>
        <div class="dim">? Add a Pro license key? <span class="bright">(Enter to skip)</span></div>
        <div class="dim">✓ kwatch is running</div>
      </div>
      <p class="install-note">The installer checks your cluster before it changes anything. Run it again any time to upgrade, change settings or manage your license.</p>
      <p class="install-note">Prefer Helm? <a href="https://github.com/abahmed/kwatch/blob/main/deploy/chart/README.md">See the chart guide.</a></p>
    </div>
  </section>

  <section id="pro" class="wrap section">
    <div class="pro-head">
      <h2 class="display h2-lg">Free. And Pro is free too.</h2>
      <p>While kwatch is in early access, Pro licenses are free for 3 months and we may renew them. Up to 2 clusters per account or company. No payment details.</p>
    </div>
    <div class="panels editions">
      <Panel title="Community" sub="Free forever. No account.">
        <p class="body">Apps that keep crashing (crash loops, out-of-memory kills), pods stuck waiting and servers that go down (NotReady nodes), explained in one line and sent to one channel.</p>
        <dl class="rows"><div><dt>Support</dt><dd>Support on GitHub.</dd></div></dl>
        <a slot="footer" class="btn btn-line" href="#install">Install</a>
      </Panel>
      <Panel title="Pro" sub="Free during early access." tone="soft">
        <p class="body">Every detector. The full proof and who made the change. Unlimited channels with routing and threads. History, audit log, maintenance windows and runbooks.</p>
        <dl class="rows"><div><dt>Support</dt><dd>Dedicated support.</dd></div></dl>
        <Fragment slot="footer">
          <a class="btn btn-solid" href="https://app.kwatch.dev">Get a free Pro license</a>
          <a class="link-strong compare" href="/pro">Compare editions →</a>
        </Fragment>
      </Panel>
    </div>
  </section>

  <section class="faq">
    <div class="faq-inner">
      <p class="eyebrow">Questions</p>
      <h2 class="display h2-md">Fair questions</h2>
      {faq.map(([q, a]) => (
        <details>
          <summary>{q}</summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="cta on-signal">
    <div class="wrap cta-inner">
      <h2 class="display">Sleep through<br />the noise.</h2>
      <a class="btn btn-solid big" href="#install">Install kwatch free</a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); gap: 48px; align-items: center; padding-block: 56px 96px; }
  .mono-line { font-family: var(--font-mono); font-size: 14px; color: var(--text-muted); }
  h1 {
    margin-top: 18px; font-family: var(--font-display); font-weight: 800;
    font-size: clamp(48px, 4vw + 32px, 92px); line-height: 0.95; letter-spacing: -0.045em;
  }
  .mark { background: var(--text); color: var(--bg); padding: 0 12px; border-radius: 8px; box-decoration-break: clone; -webkit-box-decoration-break: clone; }
  .lede { margin-top: 28px; font-size: clamp(18px, 1vw + 14px, 21px); color: var(--text-soft); max-width: 540px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; align-items: center; }
  .lede-sub { margin-top: 12px; color: var(--text-muted); max-width: 540px; }
  .quick { border-bottom: 1px solid var(--line); }
  .quick-steps { list-style: none; padding: 0; margin-top: 20px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .quick-steps h3 { margin: 8px 0; font-family: var(--font-display); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; line-height: 1.15; }
  .quick-steps p:not(.eyebrow) { color: var(--text-soft); }
  .benefits { list-style: none; padding: 0; margin-top: 48px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .benefits li { background: var(--bg); padding: 22px; }
  .benefits svg { color: var(--text); }
  .b-name { margin-top: 12px; font-weight: 600; }
  .b-text { margin-top: 4px; font-size: 14px; color: var(--text-muted); }
  .quick-note { margin-top: 20px; font-size: 14px; color: var(--text-muted); }
  .cell-term { margin-top: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--text-muted); }
  .glossary { margin-top: 32px; border: 1px solid var(--line); border-radius: 10px; padding: 4px 20px; background: var(--bg); }
  .glossary summary { cursor: pointer; font-weight: 600; padding: 14px 0; }
  .glossary dl { display: grid; grid-template-columns: 180px 1fr; gap: 12px 24px; padding: 4px 0 18px; }
  .glossary dt { font-family: var(--font-mono); font-size: 14px; }
  .glossary dd { margin: 0; color: var(--text-soft); }
  .big-link { padding: 16px 22px; font-size: 17px; }
  .hero-visual { padding: 8px 0; min-width: 0; }
  .noise { list-style: none; padding: 0; display: flex; flex-direction: column; gap: 6px; font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  .noise li { padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; overflow-wrap: anywhere; }
  .noise .dim1 { opacity: .6; }
  .noise .dim2 { opacity: .4; }
  .card {
    margin: -150px 0 0 28px; position: relative; background: var(--ink); color: var(--ink-text);
    border-radius: 14px; padding: 24px 24px 22px; box-shadow: 0 24px 60px rgba(14, 17, 22, .28);
  }
  .card-top { display: flex; justify-content: space-between; gap: 12px; font-family: var(--font-mono); font-size: 12px; color: var(--ink-muted); }
  .signal { color: var(--ink-text); font-weight: 600; }
  .card-title { margin-top: 14px; font-family: var(--font-display); font-weight: 700; font-size: 24px; line-height: 1.2; }
  .card dl { margin-top: 16px; display: grid; grid-template-columns: 80px 1fr; gap: 6px 12px; font-size: 15px; }
  .card dt { color: var(--ink-muted); }
  .card code { font-size: 13px; }
  .note { margin: 14px 0 0 28px; font-size: 13px; color: var(--text-muted); }

  /* Failure strip */
  .strip { background: var(--ink); color: var(--ink-text); overflow: hidden; white-space: nowrap; font-family: var(--font-mono); font-size: 15px; padding: 16px 0; }
  .track { display: inline-flex; animation: scroll 60s linear infinite; will-change: transform; }
  .run { display: inline-block; padding-left: 24px; }
  .item { margin-right: .6em; }
  .item i { font-style: normal; color: var(--ink-muted); margin-left: .6em; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .strip { overflow-x: hidden; }
  }

  /* Sections (shared rhythm and sizes live in global.css) */
  .underline { box-shadow: inset 0 -0.12em 0 var(--text); }
  .resolved { color: var(--resolved); }
  .failing { color: var(--failing); }

  /* How */
  .steps { list-style: none; padding: 0; margin-top: 64px; display: grid; grid-template-columns: 4fr 5fr 3fr; border-top: 2px solid var(--text); }
  .steps > li { padding: 32px; border-right: 1px solid var(--line); min-width: 0; }
  .steps > li:first-child { padding-left: 0; }
  .steps > li:last-child { padding-right: 0; border-right: 0; }
  .steps h3 { margin: 12px 0 8px; font-family: var(--font-display); font-weight: 700; font-size: 24px; letter-spacing: -0.02em; line-height: 1.15; }
  .steps p:not(.eyebrow) { color: var(--text-soft); }
  .trace { list-style: none; padding: 0; margin-top: 18px; font-family: var(--font-mono); font-size: 13px; display: flex; flex-direction: column; gap: 6px; }
  .trace li { padding: 8px 12px; border: 1px solid var(--line); border-radius: 4px; color: var(--text-muted); }
  .trace li:nth-child(2) { margin-left: 18px; }
  .trace li:nth-child(3) { margin-left: 36px; }
  .trace li.cause { margin-left: 54px; background: var(--text); color: var(--bg); font-weight: 500; border-color: var(--text); }

  /* Catches */
  .catches-head { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; align-items: end; }
  .catches-sub { color: var(--text-soft); font-size: 18px; }
  .grid { list-style: none; padding: 0; margin-top: 48px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .grid li { background: var(--bg); padding: 22px; }
  .cell-name { font-weight: 600; }
  .cell-text { margin-top: 6px; font-size: 14px; color: var(--text-muted); }

  /* Quiet */
  .quiet { display: grid; grid-template-columns: 5fr 7fr; gap: 64px; align-items: center; }
  .quiet-lede { margin-top: 18px; color: var(--text-soft); font-size: 18px; }
  .quiet-note { margin-top: 14px; font-size: 14px; color: var(--text-muted); }
  .timeline { list-style: none; margin: 0; padding: 0 0 0 24px; border-left: 2px solid var(--text); display: flex; flex-direction: column; gap: 22px; }
  .time { font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); }
  .event { margin-top: 2px; font-weight: 600; }

  /* Install */
  .install { background: var(--ink); color: var(--ink-text); }
  .terminal { margin-top: 48px; background: var(--ink); border: 1px solid var(--ink-line); border-radius: 10px; padding: 26px 28px; font-family: var(--font-mono); font-size: 16px; overflow-x: auto; white-space: pre; }
  .terminal .gap { margin-top: 16px; }
  .dim { color: var(--ink-muted); }
  .bright { color: var(--ink-text); }
  .install-note a { color: var(--ink-text); text-decoration: underline; }
  .install-note code { color: var(--ink-text); }
  .install-note { margin-top: 20px; color: var(--ink-muted); font-size: 15px; }

  /* Pro */
  .pro-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 24px; align-items: end; }
  .pro-head p { max-width: 400px; color: var(--text-soft); }
  .pro-head .h2-lg { margin-top: 0; }
  .editions { margin-top: 48px; }
  .compare { padding: 13px 8px; }

  /* FAQ */
  .faq { border-top: 1px solid var(--line); }
  .faq-inner { max-width: 900px; margin: 0 auto; padding: 96px var(--gutter); }
  .faq h2 { margin-bottom: 24px; }
  details { border-top: 1px solid var(--line); padding: 20px 0; }
  details:last-of-type { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; font-size: 19px; }
  details p { margin-top: 10px; color: var(--text-soft); }

  /* CTA */
  .cta { background: var(--signal); color: var(--on-signal); }
  .cta-inner { padding-block: 96px; display: flex; flex-wrap: wrap; gap: 32px; align-items: end; justify-content: space-between; }
  .cta h2 { font-size: clamp(44px, 4.4vw + 24px, 80px); line-height: .95; letter-spacing: -0.05em; }

