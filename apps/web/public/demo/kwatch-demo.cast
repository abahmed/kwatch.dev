[0.002, "o", "\u001b[2K\r\u001b[2m  \u2191/\u2193 move \u00b7 1-9 pick \u00b7 \u23ce choose \u00b7 esc back\u001b[0m\u001b[K\r\n\u001b[2K\r\u001b[1m\u001b[38;5;38m \u276f \ud83d\udcca View status\u001b[0m\u001b[K\r\n\u001b[2K\r   \u001b[2m\ud83d\udcdc View recent logs\u001b[0m\u001b[K\r\n\u001b[2K\r   \u001b[2m\u2b06\ufe0f  Upgrade kwatch\u001b[0m\u001b[K\r\n\u001b[2K\r   \u001b[2m\ud83d\udd0c Edit notification providers\u001b[0m\u001b[K\r\n"]
