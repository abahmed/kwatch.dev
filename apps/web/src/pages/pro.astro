---
import Base from '../layouts/Base.astro';
import BenefitIcon from '../components/BenefitIcon.astro';

type Row = [string, string, string, boolean?]; // label, community, pro, community is a dash
const groups: { name: string; rows: Row[] }[] = [
  {
    name: 'DETECTION',
    rows: [
      ['Crash loops, OOM kills, image pull and config errors', 'Yes', 'Yes'],
      ['Pending, Unschedulable, Evicted, Failed, stuck Terminating', 'Yes', 'Yes'],
      ['Liveness and startup probe failures', 'Yes', 'Yes'],
      ['Node NotReady', 'Yes', 'Yes, plus pressure and draining'],
      ['Readiness probe failures', '—', 'Yes'],
      ['Preemption, admission rejection, grace-period kills, scheduling gates', '—', 'Yes'],
      ['Stuck rollouts, failed Jobs and CronJobs', '—', 'Yes'],
      ['Storage, network, certificates, quota, admission', '—', 'Yes'],
      ['Control plane, custom resources, unusual events', '—', 'Yes'],
    ],
  },
  {
    name: 'ANALYSIS',
    rows: [
      ['Root cause', 'One-line cause', 'Full proof and confidence'],
      ['Shared-factor causes ("node X explains N failures")', '—', 'Yes'],
      ['Recent changes and who made them', '—', 'Yes'],
      ['Affected services and log excerpts', '—', 'Yes'],
    ],
  },
  {
    name: 'ALERTS',
    rows: [
      ['Channels', '1', 'Unlimited'],
      ['Routing by namespace and severity, threads, templates', '—', 'Yes'],
      ['Noise control and silences', 'Yes', 'Yes, plus flapping and maintenance windows'],
    ],
  },
  {
    name: 'OPERATIONS',
    rows: [
      ['Prometheus /metrics endpoint', '—', 'Yes'],
      ['/status', 'Short', 'Full'],
      ['Incident history across restarts', '—', 'Yes'],
      ['Audit log, runbooks, heartbeat monitor', '—', 'Yes'],
      ['Account needed', 'No', 'Yes, email only'],
    ],
  },
];

const license: [string, string][] = [
  ['One cluster', 'A key runs one cluster. Move it to another up to 3 times in 30 days, from the installer or your account.'],
  ['If it can\'t reach kwatch.dev', 'Pro keeps working for up to 7 days after its last successful license check, then falls back to Community features. Monitoring continues.'],
  ['When it ends', 'kwatch falls back to Community. Alerts never stop.'],
];
---
<Base
  current="pro"
  title="Pro, free during early access · kwatch"
  description="Community names what broke. Pro adds the full chain of cause, who made the change, what else is hit and the logs that prove it. Free during early access."
>
  <section class="hero wrap">
    <div>
      <p class="badge">Free during early access</p>
      <h1>Pro shows you<br />the whole story.</h1>
      <p class="lede">Community names what broke. Pro adds the full chain of cause, who made the change, what else is hit, and the logs that prove it.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="https://app.kwatch.dev">Get a free Pro license</a>
        <a class="alt" href="#get-pro">Already have a key? Add it in the installer</a>
      </div>
    </div>
  </section>

  <section class="wrap cards-sec" aria-label="Community and Pro at a glance">
    <div class="cards">
      <div class="card">
        <p class="label">Community</p>
        <p class="line">Free forever. No account, no key.</p>
        <ul>
          <li>One-line root-cause headline for every failure</li>
          <li>Crash loops, OOM kills, Pending pods, probe failures, Node NotReady</li>
          <li>1 alert channel, with quiet-by-default noise control</li>
        </ul>
      </div>
      <div class="card">
        <p class="label">Pro</p>
        <p class="line">Free during early access.</p>
        <ul>
          <li>Full proof and confidence for each root cause</li>
          <li>Readiness probes, shared-factor causes and Prometheus /metrics</li>
          <li>Recent changes and who made them</li>
          <li>Affected services and log excerpts</li>
          <li>Unlimited channels, routing, incident history, audit log</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap early">
    <h2 class="display">Free during early access</h2>
    <p>Each Pro license is free for 3 months, and we may renew it. One license runs one cluster, up to 2 per account or company. No payment details. If that ever changes, you will hear well in advance.</p>
  </section>

  <section id="get-pro" class="wrap steps-sec">
    <h2 class="display">Get Pro in three steps</h2>
    <ol class="steps">
      <li>
        <span class="n" aria-hidden="true">1</span>
        <h3>Get a key</h3>
        <p>Sign in at app.kwatch.dev with your email and press "Get a free Pro license". Your key appears right away.</p>
      </li>
      <li>
        <span class="n" aria-hidden="true">2</span>
        <h3>Run the installer</h3>
        <p>One command, and it walks you through it.</p>
        <div class="cmd">
          <code id="install-cmd">/bin/bash -c "$(curl -fsSL https://kwatch.dev/kwatch.sh)"</code>
          <button type="button" class="copy" data-copy="install-cmd" aria-label="Copy install command">Copy</button>
        </div>
        <p class="note">Already installed? Run it again.</p>
      </li>
      <li>
        <span class="n" aria-hidden="true">3</span>
        <h3>Add the key</h3>
        <p>Choose License / Pro, then Add or replace key.</p>
      </li>
    </ol>
    <p class="helper">Licenses are managed only through the installer.</p>
    <p class="sr-only" role="status" aria-live="polite" id="copy-status"></p>
  </section>

  <section class="wrap compare">
    <h2 class="display">Community and Pro, side by side</h2>
    <div class="scroll" role="region" aria-label="Community and Pro comparison table" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">What you get</th><th scope="col">Community</th><th scope="col" class="pro-col">Pro</th></tr>
        </thead>
        {groups.map((g) => (
          <tbody>
            <tr class="group"><th scope="colgroup" colspan="3">{g.name}</th></tr>
            {g.rows.map(([label, c, p]) => (
              <tr>
                <th scope="row">{label}</th>
                <td class:list={{ none: c === '—' }}>{c}</td>
                <td class="pro-col">{p}</td>
              </tr>
            ))}
          </tbody>
        ))}
      </table>
    </div>
    <p class="helper">Community is free forever. Pro is free during early access. In Community, Pro checks still run and show how many issues they found, by category only.</p>
  </section>

  <section class="data-sec" aria-labelledby="data-title">
    <div class="wrap data">
      <div>
        <h2 id="data-title" class="display"><BenefitIcon name="data" /> Root cause, without your data leaving the cluster.</h2>
        <p class="data-line">kwatch analyzes events and logs where they live.</p>
        <p class="data-small">Only optional anonymous usage stats and Pro license checks reach kwatch.dev. Never cluster names, pod names, logs or events. Alerts go only to the channels you set up.</p>
        <a class="alt" href="https://docs.kwatch.dev/architecture/data-flow">What is sent</a>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap license">
      <h2 class="display">How the license works</h2>
      <dl>
        {license.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
    </div>
  </section>

  <section class="cta on-signal">
    <div class="wrap cta-inner">
      <h2 class="display">Get your free Pro license.</h2>
      <a class="btn btn-solid big" href="https://app.kwatch.dev">Get a free Pro license</a>
    </div>
  </section>
  <script is:inline src="/copy.js"></script>
</Base>

<style>
  .hero { padding-block: 64px 48px; }
  .badge { display: inline-block; background: var(--surface); color: var(--text); border: 1px solid var(--control-border); padding: 4px 12px; border-radius: 999px; font-size: 14px; font-weight: 600; }
  h1 { margin-top: 20px; font-family: var(--font-display); font-weight: 800; font-size: clamp(44px, 3.4vw + 28px, 84px); line-height: .95; letter-spacing: -0.045em; }
  .lede { margin-top: 22px; font-size: clamp(18px, .6vw + 15px, 20px); color: var(--text-soft); max-width: 600px; }
  .hero-actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 16px 24px; align-items: center; }
  .alt { text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }

  .cards-sec { padding-bottom: 72px; }
  .cards { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 28px; }
  .label { font-family: var(--font-mono); font-size: 13px; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
  .line { margin-top: 8px; font-family: var(--font-display); font-weight: 800; font-size: 24px; letter-spacing: -0.02em; }
  .card ul { margin: 16px 0 0; padding-left: 20px; color: var(--text-soft); display: grid; gap: 8px; }

  .early { padding-bottom: 72px; }
  .early > * { max-width: 760px; }
  .early h2, .steps-sec h2 { font-size: clamp(30px, 1.6vw + 24px, 44px); }
  .early p { margin-top: 16px; color: var(--text-soft); font-size: 18px; }

  .steps-sec { padding-bottom: 80px; }
  .steps { list-style: none; padding: 0; margin: 32px 0 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .steps li { border-top: 2px solid var(--text); padding-top: 16px; min-width: 0; }
  .n { display: inline-flex; width: 32px; height: 32px; align-items: center; justify-content: center; border: 2px solid var(--text); border-radius: 50%; font-family: var(--font-mono); font-weight: 600; }
  .steps h3 { margin-top: 12px; font-family: var(--font-display); font-weight: 800; font-size: 22px; }
  .steps p { margin-top: 8px; color: var(--text-soft); }
  .cmd { margin-top: 12px; display: flex; gap: 8px; align-items: flex-start; background: var(--surface); border: 1px solid var(--line); border-radius: 6px; padding: 10px 12px; }
  .cmd code { flex: 1; min-width: 0; font-size: 13px; overflow-wrap: anywhere; color: var(--text); }
  .copy { flex: none; font: inherit; font-size: 13px; font-weight: 600; padding: 4px 10px; border: 1px solid var(--control-border); border-radius: 4px; background: transparent; color: var(--text); cursor: pointer; }
  .copy:hover { border-color: var(--text); }
  .steps .note { font-size: 14px; color: var(--text-muted); }
  .helper { margin-top: 24px; color: var(--text-soft); }

  .data-sec { background: var(--surface); }
  .data { padding-block: 80px; }
  .data h2 { font-size: clamp(30px, 1.6vw + 24px, 44px); max-width: 20ch; display: flex; gap: 14px; align-items: flex-start; }
  .data h2 :global(svg) { flex: none; margin-top: .2em; }
  .data-line { margin-top: 20px; font-size: 19px; color: var(--text-soft); }
  .data-small { margin-top: 12px; font-size: 15px; color: var(--text-muted); max-width: 60ch; }
  .data .alt { display: inline-block; margin-top: 14px; }

  .compare { padding-block: 24px 100px; }
  .compare h2 { font-size: clamp(30px, 1.6vw + 24px, 44px); }
  .scroll { margin-top: 32px; overflow-x: auto; border-radius: 6px; }
  table { width: 100%; min-width: 640px; border-collapse: collapse; font-size: 16px; }
  thead th { text-align: left; padding: 14px 0; border-bottom: 2px solid var(--text); }
  thead th:first-child { width: 52%; font-weight: 600; }
  th.pro-col, td.pro-col { padding-inline: 12px; }
  thead th:not(:first-child) { padding-inline: 12px; }
  thead th.pro-col { background: var(--text); color: var(--bg); }
  .group th { text-align: left; padding: 22px 0 8px; font-family: var(--font-mono); font-weight: 400; font-size: 13px; color: var(--text-muted); }
  tbody th[scope='row'] { text-align: left; font-weight: 400; padding: 12px 12px 12px 0; }
  tbody tr:not(.group) > * { border-bottom: 1px solid var(--line); }
  td { padding-right: 12px; }
  td.none { color: var(--text-muted); }

  .license { display: grid; grid-template-columns: 5fr 7fr; gap: 56px; padding-block: 90px; }
  .license h2 { font-size: clamp(30px, 1.6vw + 24px, 44px); }
  dl { display: grid; grid-template-columns: 200px 1fr; gap: 18px 24px; }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--text-soft); }

  .cta { background: var(--signal); color: var(--on-signal); }
  .cta-inner { padding-block: 96px; display: flex; flex-wrap: wrap; gap: 32px; align-items: end; justify-content: space-between; }
  .cta h2 { font-size: clamp(44px, 4.4vw + 24px, 80px); line-height: .95; letter-spacing: -0.05em; }
  .btn.big { padding: 18px 32px; font-size: 18px; }

  @media (max-width: 960px) {
    .hero { padding-block: 40px 32px; }
    .cards, .steps { grid-template-columns: 1fr; }
    .data { padding-block: 56px; }
    .license { grid-template-columns: 1fr; gap: 28px; padding-block: 64px; }
    .compare { padding-bottom: 64px; }
    .cta-inner { padding-block: 64px; }
  }
  @media (max-width: 560px) {
    dl { grid-template-columns: 1fr; gap: 4px; }
    dd { margin-bottom: 14px; }
  }
</style>
