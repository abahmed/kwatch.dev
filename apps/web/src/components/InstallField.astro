---
interface Props { id?: string; label?: string; onSignal?: boolean }
const { id, label, onSignal = false } = Astro.props;
---
<div class="install-field" class:list={{ 'on-sig': onSignal }} data-install id={id}>
  {label && <p class="install-label">{label}</p>}
  <div class="field-row">
    <div class="field" role="group" aria-label="Installer command" tabindex="0"><code>/bin/bash -c "$(curl -fsSL https://kwatch.dev/kwatch.sh)"</code></div>
    <button type="button" class="btn btn-line copy" data-copy hidden>Copy</button>
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-status></p>
</div>

<style>
  .install-label { font-family: var(--font-mono); font-size: var(--text-micro); color: var(--text-muted); margin-bottom: var(--space-2); }
  .field-row { display: flex; gap: var(--space-3); align-items: stretch; }
  .field {
    flex: 1 1 auto; min-width: 0; display: flex; align-items: center; min-height: var(--hit);
    background: var(--surface); border: var(--btn-border) solid var(--line); border-radius: var(--radius-input);
    padding: var(--space-3) var(--space-4); font-family: var(--font-mono); font-size: 15px; overflow-wrap: anywhere;
  }
  .field code { user-select: all; }
  .copy { cursor: pointer; font: inherit; font-weight: 600; background: transparent; flex: 0 0 auto; }
  .on-sig .install-label { color: var(--on-signal); }
  .on-sig .field { background: transparent; border-color: var(--on-signal); }
  .on-sig .copy { background: var(--ink); color: var(--ink-text); border-color: var(--ink); }
  .on-sig .copy:hover, .on-sig .copy:focus-visible { background: var(--ink-line); border-color: var(--ink-line); color: var(--ink-text); }
  @media (max-width: 700px) {
    .field-row { flex-direction: column; }
    .copy { width: 100%; }
    .field { font-size: 14px; }
  }
</style>
